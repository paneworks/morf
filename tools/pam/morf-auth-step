#!/bin/sh
# morf-auth-step STEP -- a marker in a PAM stack (pam_exec, `optional`):
# tells the person's morf shell which step an authentication has reached --
# face, finger, password, ok -- so it can show it (lib.authsteps).
#
# It runs as root inside sudo and must not hold it up: it writes one line
# where the shell is watching and returns. A marker never fails what it
# marks (the lines are `optional`).
# pam_exec hands over PAM's environment and little else: no PATH.
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
step=${1:-}
user=${PAM_USER:-}
[ -n "$step" ] && [ -n "$user" ] || exit 0
uid=$(id -u "$user" 2>/dev/null) || exit 0
dir=/run/user/$uid/morf
[ -d "$dir" ] || exit 0
# One line in the person's runtime directory, which their shell watches
# (lib.authsteps). Written aside and moved into place, so it is never read
# half written; nothing of theirs is run from here, and nothing waits.
f=$dir/authstep
printf '%s %s\n' "$step" "${PAM_SERVICE:-}" > "$f.new" || exit 0
chown "$uid" "$f.new" 2>/dev/null
mv -f "$f.new" "$f"
exit 0
